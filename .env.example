# Copy to .env (ignored). Docker Compose reads this file; the bare API does not.
COMPOSE_PROJECT_NAME=musiclatte
# Existing absolute directory; mounted read-only. Never use a private path in committed examples.
MUSIC_PATH=/absolute/path/to/music
# State uses six project-scoped Docker named volumes (docker volume inspect for host Mountpoint).
# Do not reuse another installation's project name/volumes. Keep COMPOSE_PROJECT_NAME stable on upgrades.
GONIC_UID=1000
GONIC_GID=1000
# Both published ports are FIXED to 127.0.0.1 in base Compose.
GATEWAY_PORT=8080
GONIC_ADMIN_PORT=4748
# Production: external HTTPS reverse proxy -> loopback gateway; no auto TLS or DNS changes.
PUBLIC_ORIGIN=https://music.example.com
# Operator-chosen positive lifetime; blank deliberately prevents startup until configured.
SESSION_MAX_AGE_SECONDS=
ALLOW_SCAN=false
# Phase 7 extensions are explicit opt-ins. Prefer deploy/compose.listening.yaml to enable the set.
MIXES_ENABLED=false
LISTENING_ENABLED=false
LISTENING_SCROBBLE_ENABLED=false
STREAM_QUALITY_ENABLED=false
ARTIST_INFO_ENABLED=false
# S04 has no approved product UI. Enable only for isolated test/deep-link checks.
WEB_UI_ENABLED=false
# Local HTTP: add -f deploy/compose.test.yaml (loopback only).
# LAN HTTP: separate deploy/compose.lan-development.yaml AFTER loopback password change.
# LAN_BIND_ADDRESS=<private LAN IP>; LAN_PORT=8081; LAN_PUBLIC_ORIGIN=http://<private LAN IP>:8081
# ADMIN_SETUP_COMPLETE=true is operator attestation, never a substitute for changing the password.
# Trusted-LAN gonic administration is a second explicit overlay; omit it to stay loopback-only.
# GONIC_LAN_ADMIN_PORT=4749 is used only by deploy/compose.lan-admin.yaml.
# Never place an administrator password, session token or key material here.

# Optional imports overlay only: absolute private file paths, never credential values.
# Keep UID/GID 1000:1000 to share the API's private management SQLite volume.
IMPORT_UID=1000
IMPORT_GID=1000
IMPORT_POLICY_FILE=/absolute/private/path/import-policy.json
IMPORT_CREDENTIAL_FILE=/absolute/private/path/import-worker.json
# Optional metadata overlay: private absolute paths; never commit populated files.
# METADATA_POLICY_FILE=/private/metadata-policy.json
# METADATA_CREDENTIAL_FILE=/private/metadata-worker.json
# METADATA_UID=1000
# METADATA_GID=1000
