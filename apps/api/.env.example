# Passed through the shell; no automatic .env loading.
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
# Trusted browser origin, independent of HOST/PORT and the SPA path base.
PUBLIC_ORIGIN=http://127.0.0.1:3000
# Fixed origin-root gonic upstream; no request-supplied URL is accepted.
GONIC_UPSTREAM=http://127.0.0.1:4747
# Absolute private paths, separate from gonic/media. Provision key explicitly first.
MANAGEMENT_DIRECTORY=/replace/with/private/management
CREDENTIAL_KEY_PATH=/replace/with/private/secrets/credential.key
# Required operator policy; replace with a positive integer (no implicit retention).
SESSION_MAX_AGE_SECONDS=
SUBSONIC_TIMEOUT_MS=5000
ALLOW_SCAN=false
